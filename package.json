{
  "name": "inventory-management-system",
  "version": "1.0.0",
  "description": "Modern serverless inventory management system built with React Router v7 and Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "wrangler pages dev ./build/client",
    "typecheck": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:migrate": "wrangler d1 migrations apply inventory-dev --local",
    "db:migrate:prod": "wrangler d1 migrations apply inventory-prod",
    "db:seed": "tsx scripts/seed.ts",
    "deploy": "wrangler pages deploy ./build/client"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.1",
    "@clerk/react-router": "^0.8.0",
    "@react-router/cloudflare": "^7.1.0",
    "@react-router/node": "^7.1.0",
    "@react-router/serve": "^7.1.0",
    "react-router": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.462.0",
    "recharts": "^2.15.0",
    "zod": "^3.23.8",
    "date-fns": "^4.1.0",
    "bwip-js": "^4.6.1",
    "xlsx": "^0.18.5",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.1",
    "sharp": "^0.33.5",
    "isbot": "^5.1.17",
    "vite-tsconfig-paths": "^5.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@react-router/dev": "^7.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/bwip-js": "^4.5.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "wrangler": "^3.86.1",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
